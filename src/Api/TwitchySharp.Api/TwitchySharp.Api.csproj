<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	  <LangVersion>latest</LangVersion>
	  <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TwitchySharp.Api</PackageId>
    <Authors>Yoyoyopo5</Authors>
    <Description>Provides core types and functions for integrating .NET Core applications with the Twitch Developer API.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

	<ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Authentication" />
    <InternalsVisibleTo Include="$(AssemblyName).Helix" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests.Unit" />
    <InternalsVisibleTo Include="$(AssemblyName).Helix.Tests.Unit" />
    <InternalsVisibleTo Include="$(AssemblyName).Authentication.Tests.Unit" />
    <InternalsVisibleTo Include="$(AssemblyName).Tests.Integration" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="../../TwitchySharp.Core/TwitchySharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
