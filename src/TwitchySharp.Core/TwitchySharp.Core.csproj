<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TwitchySharp.Core</PackageId>
    <Authors>Yoyoyopo5</Authors>
    <Description>Models and infrastructure for TwitchySharp shared between the Api and EventSub modules.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests.Unit" />
    <InternalsVisibleTo Include="TwitchySharp.Tests.Unit.Toolkit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yoyoyopo5.ValueWrapper" />
  </ItemGroup>

</Project>