{{- capture nl }}
{{ end -}}

{{- 
    func recursively_add_parents 
        $index = $0
        $list = $1
        $content = $2
        $indent = $3

        if $index < $list.size
            $indent + $list[$index] + nl + "{" + nl
            recursively_add_parents ($index + 1) $list $content ($indent + "    ")
            $indent + nl + "}" + nl
        else
            $indented_content = $indent + ($content | string.replace nl (nl + $indent))
            $indented_content
        end
    end
-}}

{{- capture t }}
{{- if add_json_converter }}[JsonConverter(typeof({{ type_name }}JsonConverter))]{{ end }}
{{ partial_definition }}
{
    {{- if add_value_property }}
    public required {{ wrapped_type_name }} Value { get; init; }
    {{- end }}
    {{- if add_implicit_operator }}
    public static implicit operator {{ wrapped_type_name }}({{ type_name }} wrapper) => wrapper.Value;
    {{- end }}
    {{- if add_to_string_override }}
    public override global::System.String ToString() => Value?.ToString() ?? global::System.String.Empty;
    {{- end }}
    {{- if add_json_converter }}
    private class {{ type_name }}JsonConverter : JsonConverter<{{ type_name }}>
    {
        public override {{ type_name }}{{ is_struct ? "" : "?" }} Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
        {
            if (JsonSerializer.Deserialize<{{ wrapped_type_name }}>(ref reader, options) is not {{ wrapped_type_name }} value)
                return default;
            {{- case json_constructor_method }}
            {{- when "constructor" }}
            return new {{ type_name }}(value);
            {{- when "initializer" }}
            return new {{ type_name }} { Value = value };
            {{- else }}
            return new {{ type_name }}();
            {{- end }}
        }
        public override void Write(Utf8JsonWriter writer, {{ type_name }} value, JsonSerializerOptions options)
        {
            JsonSerializer.Serialize(writer, value.Value, options);
        }
    }
    {{- end }}
}
{{- end -}}

// <auto-generated/>
#nullable enable
{{~ if add_json_converter }}
using System;
using System.Text.Json;
using System.Text.Json.Serialization;
{{ end }}
namespace {{ @namespace }};
{{ recursively_add_parents 0 parents t "" }}